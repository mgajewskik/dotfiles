HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=290000
SAVEHIST=$HISTSIZE
setopt extended_history     # save a timestamp with each command
setopt share_history        # share history between open terminals
setopt hist_ignore_all_dups # keep only the newest copy of a repeated command
setopt hist_ignore_space    # do not save commands that start with a space

# vi mode
bindkey -v
export KEYTIMEOUT=1 # switch modes faster

# Up/Down and j/k search history for commands starting with what is typed
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey -M vicmd 'k' up-line-or-beginning-search
bindkey -M vicmd 'j' down-line-or-beginning-search

export EDITOR=nvim
export VISUAL=nvim
export LANG="${LANG:-C.UTF-8}"
export GPG_TTY="$(tty)"
[[ -z $SSH_AUTH_SOCK && -S $XDG_RUNTIME_DIR/ssh-agent.socket ]] && export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
export BAT_THEME=ansi
export SHELL="${commands[zsh]:-$SHELL}"

typeset -U path fpath

path=("$HOME/.local/bin" $path "$HOME/.cargo/bin" "$HOME/go/bin" "$HOME/scripts" "$HOME/.opencode/bin")
path+=("$HOME/.tmux/plugins/tmux-session-wizard/bin")
path+=("$HOME/.local/share/nvim/mason/bin")

if command -v mise > /dev/null ; then
  eval "$(mise activate zsh)"
fi

autoload -Uz compinit && compinit
if command -v mise > /dev/null ; then
  source <(mise completion zsh) # uses the usage tool
fi
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' # case-insensitive completion
zstyle ':completion:*' menu no # let fzf-tab handle the completion menu

if command -v starship > /dev/null ; then
  eval "$(starship init zsh)"
fi

# fzf-tab: Tab opens completions in fzf. Load it before fzf so fzf's **<Tab> falls back to it.
if [[ -r "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh" ]] ; then
  source "$HOME/.zsh/fzf-tab/fzf-tab.plugin.zsh"
  zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
fi

# Ctrl-R history, Ctrl-T files, Alt-C subdirectories, **<Tab> fuzzy completion
if command -v fzf > /dev/null ; then
  source <(fzf --zsh)
fi

# cd foo jumps to the most used visited directory matching foo, cdi picks one with fzf
if command -v zoxide > /dev/null ; then
  eval "$(zoxide init zsh --cmd cd)"
fi

if command -v crib > /dev/null ; then
  source <(crib completion zsh)

  crib() { GITHUB_TOKEN="$GITHUB_READONLY" command crib "$@"; }

  claude-path() {
    local root=$PWD
    while [[ $root != / && ! -e $root/.devcontainer/devcontainer.json && ! -e $root/.devcontainer.json ]]; do
      root=${root:h}
    done
    [[ $root == / ]] && root=$PWD
    local key="/workspaces/${root:t}${PWD#$root}"
    key=${key//[^A-Za-z0-9]/-}
    mkdir -p "$HOME/.claude/projects/$key"
    print -r -- "\"type=bind,source=\${localEnv:HOME}/.claude/projects/$key,target=/home/vscode/.claude/projects/$key\""
  }

  # run in the project root: saves the running container over crib's snapshot, which `crib down && crib up` and a
  # restart after a config change recreate it from; `crib rebuild` deletes the snapshot
  snapshot() {
    local ws=$(jq -r --arg src "$PWD" 'select(.source == $src) | .id' ~/.crib/workspaces/*/workspace.json(N) 2>/dev/null)
    [[ -z $ws ]] && { print -u2 "snapshot: no crib workspace for $PWD; run it in the project root"; return 1; }
    local image=$(jq -r '.snapshotImage // empty' ~/.crib/workspaces/$ws/result.json)
    # crib uses only a snapshot it recorded itself, after the container's first create
    [[ -z $image ]] && { print -u2 "snapshot: crib has no snapshot for $ws to replace"; return 1; }
    local container=$(podman ps -q --filter "label=crib.workspace=$ws")
    [[ -z $container ]] && { print -u2 "snapshot: no running container for $ws; run crib up"; return 1; }
    podman commit --change "LABEL crib.workspace=$ws" "$container" "$image"
  }
fi

if command -v kubectl > /dev/null ; then
  source <(kubectl completion zsh 2> /dev/null)
  alias k="kubectl"
  alias ka="kubectl apply -f"
  alias kns="kubectl config set-context --current --namespace"

  export dry=" -o yaml --dry-run=client -o yaml"
  export now="--force --grace-period=0"

  alias bb="k run busybox --image=busybox:latest --restart=Never --rm -it --command -- "

  function kctx() {
      found=0
      for c in $(kubectl config get-contexts --no-headers -o name); do
          if [[ $c == $1 ]]; then
              found=1
          fi
      done
      if [[ $found == 0 ]]; then
          echo "Context $1 not found"
          return 1
      fi
      echo "Switching to context $1 and setting up aliases"

      BASE="kubectl --context=$1"

      alias k="$BASE"
      alias kg="$BASE get"
      alias ke="$BASE edit"
      alias kgp="$BASE get pod"
      alias kde="$BASE describe"
  }
fi

