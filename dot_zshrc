# list the directory after every cd
chpwd() {
  [[ -t 0 && -t 1 ]] || return 0
  eza --git --icons --group-directories-first --time-style=long-iso --group
}

# decode JWT token and return header and payload
decode() {
    jq -R 'split(".") | select(length > 0) | .[0],.[1] | @base64d | fromjson' <<< "$1"
}

# yazi, then cd to the directory it exits in
y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# Per-directory history: a mise [env] HISTFILE swaps the file on cd
_histfile_default="$HISTFILE"
_histfile_current="$HISTFILE"
_sync_histfile() {
  # read the target first: mise unsets HISTFILE when leaving, and fc -P overwrites it
  local target="${HISTFILE:-$_histfile_default}"
  [[ "$target" == "$_histfile_current" ]] && return
  HISTFILE="$_histfile_current" # fc -P saves the outgoing list here, not into the target
  fc -P 2> /dev/null            # the stack is empty on the first switch
  fc -p "$target"
  _histfile_current="$target"
}
precmd_functions+=(_sync_histfile)

