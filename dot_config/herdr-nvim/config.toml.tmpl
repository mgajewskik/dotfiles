[sidebar]
# A herdr server started over ssh (herdr --remote) inherits sshd's bare PATH, where a bare "nvim" is not found and
# prefix+e closes at once. The mise shim resolves nvim and gives it every mise tool; with nix tools, it is nvim alone.
nvim_bin = {{ if and .nixTools .nixos }}{{ joinPath .systemPrefix "bin/nvim" | quote }}{{ else if .nixTools }}{{ joinPath .chezmoi.homeDir ".nix-profile/bin/nvim" | quote }}{{ else }}{{ joinPath .chezmoi.homeDir ".local/share/mise/shims/nvim" | quote }}{{ end }}
