[Unit]
Description=swaybg
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# DP-2 (3840x1600) and eDP-1 (1920x1200) get native-size renders; other outputs fill from the 3840x1600 one.
# Keep in sync with ~/.config/swaylock/config. nixos-{nord,gruvbox-large}-* are kept as alternatives.
ExecStart={{ .systemPrefix }}/bin/swaybg -o * -i %h/.config/sway/wallpapers/nixos-kanagawa-3840x1600.png -m fill -o DP-2 -i %h/.config/sway/wallpapers/nixos-kanagawa-3840x1600.png -m fill -o eDP-1 -i %h/.config/sway/wallpapers/nixos-kanagawa-1920x1200.png -m fill
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
