[Unit]
Description=Swayidle for Sway sessions
Documentation=man:swayidle(1)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecCondition=/bin/sh -c 'case "$XDG_CURRENT_DESKTOP" in sway|sway:*) swaymsg -t get_version >/dev/null 2>&1 ;; *) exit 1 ;; esac'
# Events live in ~/.config/swayidle/config. -w lets the lock finish before the system sleeps.
ExecStart={{ .systemPrefix }}/bin/swayidle -w
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
