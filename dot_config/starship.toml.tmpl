"$schema" = 'https://starship.rs/config-schema.json'

format = "$container$all"
add_newline = false

[container]
format = "[$symbol $name]($style) "

[line_break]
disabled = {{ or .container (not .remote) }}

[character]
success_symbol = "[➜ ](bold #92E920)"
error_symbol = "[✗ ](bold red)"
vimcmd_symbol = "[❮ ](bold #92E920)" # vi normal mode

[username]
style_user = "bold dimmed blue"
format = "([$user]($style) in )"
aliases = { {{ .chezmoi.username | quote }} = "" }

[hostname]
disabled = {{ .container }}
format = "[ $hostname]($style) "
style = "bold #87A752"

[cmd_duration]
min_time = 1000
format = "󰔛 [$duration]($style)"
style = "bold italic #87A752"

[directory]
truncation_length = 10
format = "[$path]($style) [$read_only]($read_only_style)"
style = "bold #89CFF0"

[git_branch]
format = " [$symbol$branch]($style) "
symbol = " "
style = "bold yellow"

[python]
symbol = " "
format = '[${symbol}${pyenv_prefix}(${version} )(\($virtualenv\) )]($style)'
style = "bold green"

[golang]
symbol = " "
format = "via [$symbol$version](bold cyan) "

# no $version: it runs terraform version on every prompt
[terraform]
format = "[󱁢 $workspace]($style) "

# the aws module has no directory detection and shows on every prompt once ~/.aws has credentials;
# show the profile only while AWS_PROFILE is set (e.g. by a project's mise [env])
[aws]
disabled = true

[env_var.AWS_PROFILE]
symbol = "󰸏 "
style = "bold blue"
format = 'on [$symbol$env_value]($style) '

[kubernetes]
disabled = false
detect_env_vars = ["KUBECONFIG"]
format = '[$symbol$context( \($namespace\))]($style) '

[package]
disabled = true

[nodejs]
disabled = true

[ruby]
disabled = true

[gcloud]
disabled = true
