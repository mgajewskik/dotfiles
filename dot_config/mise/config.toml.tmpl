starship = "latest"
fzf = "latest"
zoxide = "latest"
"vfox:jdx/vfox-eza" = "latest"
bat = "latest"
bat-extras = "latest"
ripgrep = "latest"
fd = "latest"
dust = "latest"
yazi = "latest"
jq = "latest"
difftastic = "latest"
neovim = "latest"
tree-sitter = "latest"
k9s = "latest"
kubectl = "latest"
awscli = "latest"
uv = "latest"
