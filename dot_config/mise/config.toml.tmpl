[settings]
experimental = true
minimum_release_age = "7d"

[settings.python]
compile = true

[settings.github]
credential_command = "gh auth token"

[tools]
"github:twpayne/chezmoi" = "latest"
tmux = "latest"
usage = "latest" # needed for mise completions (sourced in ~/.zshrc)
starship = "latest"
fzf = "latest"
zoxide = "latest"
"vfox:jdx/vfox-eza" = "latest"
bat = "latest"
bat-extras = "latest"
ripgrep = "latest"
fd = "latest"
dust = "latest"
yazi = "latest"
jq = "latest"
difftastic = "latest"
neovim = "latest"
tree-sitter = "latest"
k9s = "latest"
kubectl = "latest"
uv = "latest"
ty = "latest"
"github:dalance/procs" = "latest"
gh = "latest"
go = "latest"
node = "latest" # npm-based language servers (bash, typescript)
{{- if not .container }}
"github:fgrehm/crib" = "latest"
{{- end }}
lazyssh = "latest"
lazygit = "latest"
lazyjournal = "latest"
herdr = "latest"
claude = "latest"
"github:vercel-labs/agent-browser" = "latest"
"github:rtk-ai/rtk" = "latest"
