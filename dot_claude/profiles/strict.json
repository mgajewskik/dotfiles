{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true
  },
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "~/.zinit/plugins/mise",
        "~/.config/mise",
        "~/.local/share/mise/installs",
        "~/.local/share/mise/shims",
        "~/.local/share/nvim/mason",
        "~/.local/share/terminal-browser",
        "~/.local/bin"
      ]
    }
  }
}
