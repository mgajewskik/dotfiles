{
  "owned": {
    "$schema": "https://antigravity.google/schemas/v1/settings.json",
    "permissions": {
      "allow": [
        "command(ls)",
        "mcp(context7/resolve-library-id)"
      ],
{{- if .container }}
      "deny": [
{{- range $i, $pattern := .claude.permissions.remote }}{{ if $i }},{{ end }}
        {{ printf "command(regex:%s)" (regexQuoteMeta $pattern | replace "\\*" "[\\s\\S]*") | toJson }}
{{- end }}
      ]
{{- else }}
      "deny": [
        "read_file({{ .chezmoi.homeDir }}/.ssh)",
        "read_file({{ .chezmoi.homeDir }}/.aws)",
        "read_file({{ .chezmoi.homeDir }}/.gnupg)",
        "command(sudo)",
        "command(doas)",
        "command(pkexec)",
        "command(su)",
        "command(runuser)",
        "command(regex:rm -[a-zA-Z]*[rR][a-zA-Z]*f[a-zA-Z]*)",
        "command(regex:rm -[a-zA-Z]*f[a-zA-Z]*[rR][a-zA-Z]*)",
        "command(rm -r -f)",
        "command(rm -f -r)",
        "command(rm --recursive --force)",
        "command(rm --force --recursive)",
        "command(regex:mkfs.*)",
        "command(wipefs)",
        "command(shred)",
        "command(fdisk)",
        "command(sfdisk)",
        "command(parted)",
        "command(sgdisk)",
        "command(cryptsetup)",
        "command(mkswap)",
        "command(shutdown)",
        "command(reboot)",
        "command(halt)",
        "command(poweroff)",
        "command(init 0)",
        "command(init 6)",
        "command(systemctl reboot)",
        "command(systemctl poweroff)",
        "command(systemctl halt)",
        "command(systemctl stop)",
        "command(systemctl disable)",
        "command(systemctl mask)",
        "command(systemctl --user enable)",
        "command(kill -9 -1)",
        "command(kill -KILL -1)",
        "command(kill -- -1)",
        "command(crontab)",
        "command(chmod -R 777)",
        "command(chmod 777 -R)",
        "command(chown -R)",
        "command(chattr)",
        "command(modprobe -r)",
        "command(iptables -F)",
        "command(iptables --flush)",
        "command(nft flush)",
        "command(ufw disable)",
        "command(sh -)",
        "command(bash -)",
        "command(regex:sh -s.*)",
        "command(regex:bash -s.*)",
        "command(nc -e)",
        "command(ncat -e)",
        "command(ssh -R)",
        "command(regex:git push --force.*)",
        "command(git push -f)",
        "command(git reset --hard)",
        "command(regex:git clean -[a-zA-Z]*f[a-zA-Z]*)",
        "command(git clean --force)",
        "command(git checkout .)",
        "command(git checkout -- .)",
        "command(git restore .)",
        "command(git stash clear)",
        "command(git reflog expire)",
        "command(git filter-branch)",
        "command(git filter-repo)",
        "command(terraform destroy)",
        "command(terraform state rm)",
        "command(terraform state mv)",
        "command(terraform state push)",
        "command(terraform force-unlock)",
        "command(terraform workspace delete)",
        "command(tofu destroy)",
        "command(tofu state rm)",
        "command(tofu state mv)",
        "command(tofu state push)",
        "command(tofu force-unlock)",
        "command(tofu workspace delete)",
        "command(kubectl delete)",
        "command(kubectl drain)",
        "command(helm uninstall)",
        "command(helm delete)",
        "command(aws s3 rm)",
        "command(aws s3 rb)",
        "command(gh repo delete)",
        "command(gh repo archive)",
        "command(gh secret)",
        "command(gh release create)",
        "command(gh release delete)",
        "command(npm publish)",
        "command(cargo publish)",
        "command(twine upload)",
        "command(gem push)",
        "command(docker system prune)",
        "command(docker volume prune)",
        "command(docker volume rm)",
        "command(podman system prune)",
        "command(podman volume rm)"
      ]
{{- end }}
    },
    "statusLine": {
      "type": "command",
      "command": "~/.claude/statusline.sh",
      "enabled": true
    },
    "toolPermission": "always-proceed"
  },
  "defaults": {
    "model": "Gemini 4 Neon (XHigh)",
    "agentMode": "accept-edits",
    "altScreenMode": "always"
  }
}
