{{- $rules := dict
      "deny" (includeTemplate "claude/bash-rules" .claude.permissions.deny | fromJson)
      "remote" (includeTemplate "claude/bash-rules" .claude.permissions.remote | fromJson)
      "ask" (includeTemplate "claude/bash-rules" .claude.permissions.ask | fromJson) -}}
{
  "owned": {
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "env": {
      "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "true"
    },
    "attribution": {
      "commit": "",
      "pr": "",
      "sessionUrl": false
    },
    "permissions": {
      "allow": [
        "mcp__context7",
        "WebFetch",
        "WebFetch(domain:*)"
      ],
      "additionalDirectories": [
        "~/.agents/skills"
      ],
{{- if .container }}
      "defaultMode": "auto",
      "deny": {{ $rules.remote | toJson }}
{{- else }}
      "defaultMode": "auto",
      "deny": {{ concat (list "Read(~/.ssh/**)" "Read(~/.aws/**)" "Read(~/.gnupg/**)") $rules.deny $rules.remote | toJson }},
      "ask": {{ $rules.ask | toJson }}
{{- end }}
    },
    "hooks": {
      "PreToolUse": [
{{- if not .container }}
        {
          "matcher": "Edit|Write|NotebookEdit",
          "hooks": [
            {
              "type": "command",
              "command": "bash \"$HOME/.claude/hooks/block-writes-outside-cwd.sh\""
            }
          ]
        },
{{- end }}
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "rtk hook claude"
{{- if not .container }}
            },
            {
              "type": "command",
              "command": "bash \"$HOME/.claude/hooks/block-cd-heredoc.sh\""
{{- end }}
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "matcher": "^(startup|resume|clear|compact|fork)$",
          "hooks": [
            {
              "type": "command",
              "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
              "timeout": 10
            }
          ]
        }
      ]
    },
{{- if .container }}
    "sandbox": {
      "enabled": false
    },
{{- else }}
    "sandbox": {
      "enabled": true,
      "failIfUnavailable": true,
      "allowUnsandboxedCommands": false,
      "filesystem": {
        "allowWrite": [
          "/tmp",
          "/var/tmp",
          "~/.cache",
          "~/.local/share/mise",
          "~/.local/state/mise",
          "~/.local/share/uv",
          "~/.local/share/rtk",
          "~/go/pkg",
          "~/.ansible"
        ]
      }
    },
{{- end }}
    "statusLine": {
      "type": "command",
      "command": "~/.claude/statusline.sh"
    },
    "extraKnownMarketplaces": {
      "claude-plugins-official": {
        "source": {
          "source": "github",
          "repo": "anthropics/claude-plugins-official"
        }
      },
      "personal": {
        "source": {
          "source": "directory",
          "path": "{{ .chezmoi.homeDir }}/.claude/local-plugins"
        }
      }
    },
    "pluginConfigs": {
      "agents-md@builtin": {
        "options": {
          "instructionFiles": "claude-md-and-agents-md"
        }
      }
    },
    "bashEditDiffEnabled": false,
    "autoMemoryEnabled": true,
{{- if .container }}
    "autoMode": {
      "environment": [
        "$defaults",
        "Host containment (replaces the default Host containment entry): Claude Code runs as a non-root user with sudo in a disposable dev container. Recreating the container rebuilds everything in it from the image and dotfiles. Folders mounted from the host, the project folder among them, live outside the container and are not disposable. Actions taken with credentials in the container reach real remote systems."
      ],
      "allow": [
        "$defaults",
        "Container Tooling: Package-manager commands that install, upgrade, or download tools, dependencies, and packages by name from the manager's configured default registry, with sudo when the manager needs it. Does not cover URLs, git refs, file paths, registry or index overrides, adding package sources or signing keys, piping install scripts, or any other sudo action."
      ]
    },
    "voice": {
      "enabled": false
    },
{{- end }}
    "skipDangerousModePermissionPrompt": true
  },
  "defaults": {
    "model": "opus[1m]",
    "modelSettings": {
      "claude-opus-5-5": {
        "effortLevel": "high"
      }
    },
    "enabledPlugins": {
      "gopls-lsp@claude-plugins-official": true,
      "rust-analyzer-lsp@claude-plugins-official": true,
      "lua-lsp@claude-plugins-official": true,
      "typescript-lsp@claude-plugins-official": true,
      "terraform-lsp@personal": true,
      "bash-lsp@personal": true,
      "ty-lsp@personal": true
    },
    "autoCompactWindow": 400000,
    "tui": "fullscreen",
    "theme": "dark",
    "voice": {
      "enabled": true,
      "mode": "hold"
    },
    "agentPushNotifEnabled": true,
    "inputNeededNotifEnabled": true
  }
}
