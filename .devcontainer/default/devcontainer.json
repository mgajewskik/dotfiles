{
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.7.1": {
      "username": "vscode",
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": false,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/desktop-lite:1.2.10": {}
  },
  "forwardPorts": [
    "127.0.0.1:6080:6080",
    "127.0.0.1:5901:5902"
  ],
  "runArgs": [
    "--shm-size=1g",
    "--cap-add=NET_RAW",
    "--sysctl=net.ipv4.ping_group_range=1000 1000"
  ],
  "containerEnv": {
    "AGENT_BROWSER_HEADED": "true",
    "AGENT_BROWSER_PROFILE": "${containerWorkspaceFolder}/.browser-profile"
  },
  "mounts": [
    "type=bind,source=${localEnv:HOME}/.claude/projects/-workspaces-${localWorkspaceFolderBasename},target=/home/vscode/.claude/projects/-workspaces-${localWorkspaceFolderBasename}"
  ],
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude/projects/-workspaces-${localWorkspaceFolderBasename}",
  "postCreateCommand": "sudo apt-get update -qq && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends file build-essential jq socat bind9-dnsutils iputils-ping netcat-openbsd traceroute tcpdump mtr-tiny nmap iperf3 whois",
  "postStartCommand": {
    "vnc-relay": "setsid -f socat TCP-LISTEN:5902,fork,reuseaddr TCP:127.0.0.1:5901 >/dev/null 2>&1"
  },
  "waitFor": "postCreateCommand"
}
