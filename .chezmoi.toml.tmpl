{{- /* remote describes the session that ran init, not the host: check $SSH_CONNECTION at runtime instead */ -}}
{{- /* /run/.containerenv: podman; /.dockerenv: docker; /run/systemd/container: systemd-nspawn (agentbox). Files, unlike env vars, survive an SSH session into the container */ -}}
{{- $container := or (env "CODESPACES" | not | not) (env "REMOTE_CONTAINERS" | not | not) (env "KUBERNETES_SERVICE_HOST" | not | not) (env "container" | not | not) (stat "/run/.containerenv" | not | not) (stat "/.dockerenv" | not | not) (stat "/run/systemd/container" | not | not) -}}
{{- $remote := or $container (env "SSH_CONNECTION" | not | not) -}}
{{- $nixos := eq (dig "osRelease" "id" "" .chezmoi) "nixos" -}}

sourceDir = {{ .chezmoi.sourceDir | quote }}

# nvim rewrites lazy-lock.json locally, which blocks the --ff-only pull of the nvim external; stash it first.
# Exits 0 before the first clone, since a failing pre hook aborts the update
[hooks.update.pre]
command = "sh"
args = ["-c", "cd {{ .chezmoi.homeDir }}/.config/nvim 2>/dev/null || exit 0; git diff --quiet -- lazy-lock.json || git stash push -m 'chezmoi update: lazy-lock' -- lazy-lock.json"]

[data]
remote = {{ $remote }}
container = {{ $container }}
nixos = {{ $nixos }}
systemPrefix = {{ if $nixos }}"/run/current-system/sw"{{ else }}"/usr"{{ end }}
