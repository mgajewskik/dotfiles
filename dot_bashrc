# Claude Code's settings set BASH_ENV=$HOME/.bashrc so every Bash tool call runs this file and activates mise in
# that call's directory; its snapshot alone keeps neither mise's hooks nor its env vars. Unset it so scripts
# started from here don't activate again over what their caller set (`mise exec`).
# BASH_ENV reaches every bash that Claude starts, including hooks that run outside the sandbox, where a project's
# mise config could replace the tools they use. Hooks in the claude settings template run under `env -u BASH_ENV`;
# plugin hooks still inherit it, which is accepted because claude runs in devcontainers.
unset BASH_ENV

export EDITOR=nvim VISUAL=nvim
export LANG="${LANG:-C.UTF-8}"
[[ -z $SSH_AUTH_SOCK && -S $XDG_RUNTIME_DIR/ssh-agent.socket ]] && export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
PATH="$HOME/.local/bin:$PATH:$HOME/.cargo/bin:$HOME/go/bin:$HOME/.local/share/nvim/mason/bin"
command -v mise >/dev/null && eval "$(mise activate bash)"

[[ $- != *i* ]] && return # interactive only below; scp and rsync also need the shell above to stay silent

HISTSIZE=290000
HISTFILESIZE=$HISTSIZE
HISTCONTROL=ignorespace:erasedups
HISTTIMEFORMAT="%F %T "
shopt -s histappend

set -o vi
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind -m vi-command '"k": history-search-backward'
bind -m vi-command '"j": history-search-forward'

export GPG_TTY="$(tty)"

alias ..="cd .."
alias c="chezmoi"
alias mr="mise run"
