# Any crib container, by its podman name: ssh crib-<workspace id from `crib list`>.
Host crib-*
  User vscode
  ProxyCommand podman exec -i -u root %h sh -c 'mkdir -p /run/sshd; exec /usr/sbin/sshd -i'
  IdentityFile ~/.ssh/crib_ed25519
  IdentitiesOnly yes
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  LogLevel ERROR
